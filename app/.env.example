# Copie este arquivo para ".env" (mesma pasta) e preencha com os valores do
# seu projeto Supabase: Settings > API > Project URL / anon public key.
# Essas duas variáveis precisam começar com EXPO_PUBLIC_ pra o Expo incluí-las
# no build do app (inclusive no build web publicado na Vercel).
#
# A anon key é segura de expor no app: ela só dá acesso ao que as regras de
# RLS do banco permitirem (veja supabase/migrations/0001_schema_inicial.sql).

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
